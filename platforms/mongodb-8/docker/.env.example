# IF GNU MAKE IS INSTALLED - IT IS NOT REQUIRED TO UPDATE THIS ENVIRONMENT FILE
# REMOVE COMMENTS WHEN COPY THIS FILE AND TRIM TRAILING WHITESPACES
# Ask the team for recommended values

COMPOSE_PROJECT_LEAD=myproj"                    # <- lead abbreviation or acronym as part of related containers naming rule -------------------------> #
COMPOSE_PROJECT_CNET=mp-dev"                    # <- useful for networking to connect between containers --------------------------------------------> #
COMPOSE_PROJECT_IMGK=alpine-3.22-mongodb-8.22   # <- main container property for pulling and caching image into docker ------------------------------> #
COMPOSE_PROJECT_NAME=mp-mongodb-dev             # <- container name to build the service - it is important to set the environment in this variable --> #
COMPOSE_PROJECT_DATA="./data"                   # <- container persistant data on local machine -----------------------------------------------------> #
COMPOSE_PROJECT_LOGS="./logs"                   # <- container logs binding in local machine --------------------------------------------------------> #
COMPOSE_PROJECT_HOST=127.0.0.1                  # <- machine hostname referrer - not necessary for this project -------------------------------------> #
COMPOSE_PROJECT_CPUS=2.00                       # <- container's maximum CPUs usage to apply by docker-compose - leave it empty for full usage ------> #
COMPOSE_PROJECT_MEM=512M                        # <- container's maximum RAM usage to apply by docker-compose ---------------------------------------> #
COMPOSE_PROJECT_SWAP=1G                         # <- container's RAM swap space in storage executed by automation command ---------------------------> #
COMPOSE_PROJECT_PORT=7711                       # <- local machine port opened for container service ------------------------------------------------> #
MONGO_INITDB_DATABASE=local_dev                 # <- database name ----------------------------------------------------------------------------------> #
MONGO_INITDB_ROOT_USERNAME=user_dev             # <- database root user -----------------------------------------------------------------------------> #
MONGO_INITDB_ROOT_PASSWORD="password-dev"       # <- database root password -------------------------------------------------------------------------> #
COMPOSE_PROJECT_CLIENT_IMGK=mongo-express       # <- container property for the database client for pulling and caching image into docker -----------> #
COMPOSE_PROJECT_CLIENT_CPUS=1.00                # <- client's container maximum CPUs usage to apply by docker-compose - empty for full usage --------> #
COMPOSE_PROJECT_CLIENT_MEMO=128M                # <- client's container maximum RAM usage to apply by docker-compose --------------------------------> #
COMPOSE_PROJECT_CLIENT_SWAP=256M                # <- client's container RAM swap space in storage executed by automation command --------------------> #
COMPOSE_PROJECT_CLIENT_PORT=7712                # <- local machine port opened for client's container service client --------------------------------> #
MONGODB_EXPRESS_USERNAME=admin.user             # <- database client first user account -------------------------------------------------------------> #
MONGODB_EXPRESS_PASSWORD="admin-password"       # <- database client first user password ------------------------------------------------------------> #
COMPOSE_IGNORE_ORPHANS=true                     # <- ignore docker warnings messages when client is in used -----------------------------------------> #